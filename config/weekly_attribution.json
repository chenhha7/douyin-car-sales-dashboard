{
  "version": "1.0",
  "comparison": {
    "period": "completed_natural_week",
    "week_starts_on": "monday",
    "min_denominator": 20,
    "alert_open_rate_decline_pp": 5,
    "sla_create_to_open_hours": 72
  },
  "metric_trees": {
    "opened": {
      "label": "开启销售机会数",
      "mode": "multiplicative",
      "formula": "毛线索数 × 线索→创建率 × 创开率",
      "factors": ["gross_leads", "lead_to_create_rate", "open_rate"],
      "dimension_order": ["service_provider", "live_room", "region", "store", "product_line"],
      "primary_dimension": "store",
      "drilldown_rule": "created_not_opened_or_over_sla",
      "playbook": "opportunity_opening_decline"
    }
  },
  "action_playbook": {
    "opportunity_opening_decline": {
      "issue": "创建销售机会后未及时开启",
      "owner_role": "区域运营负责人 / 门店负责人",
      "action": "核查待开启销售机会明细、门店分单时效与承接SOP执行情况",
      "deadline_days": 2
    }
  },
  "strategy_registry": [
    {
      "strategy_id": "STR-DEMO-SOP-001",
      "strategy_name": "门店承接SOP标准化（合成演示）",
      "start_date": "2026-07-14",
      "pre_period": ["2026-06-16", "2026-07-13"],
      "post_period": ["2026-07-14", "2026-08-10"],
      "target_metrics": ["3日创开率", "30日内锁单率"],
      "note": "仅用于公开Demo展示策略复盘结构，不代表真实业务上线时间、试点范围或效果。"
    }
  ]
}
