{
  "version": "1.1",
  "comparison": {
    "period": "completed_natural_week",
    "week_starts_on": "monday",
    "min_denominator": 20,
    "alert_open_rate_decline_pp": 5,
    "sla_create_to_open_hours": 72
  },
  "metric_trees": {
    "opened": {
      "label": "开启销售机会数",
      "mode": "multiplicative",
      "formula": "毛线索数 × 线索→创建率 × 创开率",
      "factors": ["gross_leads", "lead_to_create_rate", "open_rate"],
      "dimension_order": ["service_provider", "live_room", "region", "store", "product_line"],
      "primary_dimension": "store",
      "drilldown_rule": "created_not_opened_or_over_sla",
      "verification_rule": "opened_opportunity_follow_up"
    }
  },
  "verification_guidance": {
    "opened_opportunity_follow_up": {
      "title": "待业务确认",
      "question": "该门店的待开启销售机会，是否集中在分单、首次联系或商机开启录入环节？",
      "note": "归因结果只用于锁定优先核验范围；在业务核验前，不自动下发任务，也不直接推导运营策略。"
    }
  }
}
